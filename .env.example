APP_NAME="GBX Vault"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cofre.seudominio.com
APP_TIMEZONE=America/Panama
FORCE_HTTPS=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Banco SQLite (database/database.sqlite)
DB_CONNECTION=sqlite

# Sessão: curta, cifrada, cookie seguro
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Cofre
VAULT_ISSUER="GBX Vault"
VAULT_IDLE_MINUTES=15
VAULT_MAX_ATTEMPTS=5
VAULT_LOCK_MINUTES=15
VAULT_INVITE_HOURS=72
VAULT_ATTACHMENT_MAX_KB=10240
VAULT_CLIPBOARD_SECONDS=30

VAULT_PHRASE_MIN=12
VAULT_PHRASE_MIN_WORDS=1
